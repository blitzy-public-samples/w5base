#
# databases.conf.tmpl — W5Base data-object DB connection fragment (TEMPLATE)
#
# Rendered by docker/entrypoint.sh (whitelist envsubst) into
# /etc/w5base/databases.conf (owner w5base:daemon, mode 0640).
# INCLUDEd by both w5server.conf and w5base.conf so the control plane
# (W5Server) and the web/app path (bin/app.pl, W5Event TableVersionCheck)
# share one DB definition.
#
# Only two values are substituted from the environment at render time:
#   - W5BASE_DSN         : the DBI connect string (must target host=db, the
#                          Compose service name, NOT localhost).
#   - W5BASE_DB_PASSWORD : the w5base application DB password (never hardcoded).
# The bracket index [w5base] is the data-object connection name and is a
# LITERAL — envsubst leaves it untouched.
#
DATAOBJCONNECT[w5base]="${W5BASE_DSN}"
DATAOBJUSER[w5base]="w5base"
DATAOBJPASS[w5base]="${W5BASE_DB_PASSWORD}"
