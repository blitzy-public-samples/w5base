#
# w5server.conf.tmpl — W5Server (control-plane) config (TEMPLATE)
#
# Rendered by docker/entrypoint.sh (whitelist envsubst) into
# /etc/w5base/w5server.conf, then read by: sbin/W5Server -c w5server.
# W5Server is the persistent TCP process server the web frontend depends on.
#
# Pulls DB credentials from the shared databases.conf fragment via INCLUDE.
# Two values are substituted from the environment at render time:
#   - W5BASESRVUSER          the service account W5Server runs as (defaults w5base)
#   - W5BASE_OPERATION_MODE  the operation mode (see W5BaseOperationMode below)
# All other values are literals mirroring etc/w5base/default.conf.
#
# WHY W5BaseOperationMode is rendered HERE (rather than left to inherit
# etc/w5base/default.conf): the operation mode MUST be IDENTICAL for the control
# plane (W5Server) and the web frontend (w5base.conf). default.conf ships
# "online", so if this template omitted the mode, W5Server would silently
# inherit "online" while the frontend ran ${W5BASE_OPERATION_MODE} — a
# divergence W5Base forbids (README.txt). Rendering the SAME env value into both
# configs (w5server.conf here and w5base.conf) keeps them in lock-step.
#
INCLUDE /etc/w5base/databases.conf
W5ServerPort="12833"
W5ServerUser="${W5BASESRVUSER}"
W5ServerGroup="daemon"
W5ServerState="/var/opt/w5base/state"
W5ServerAllow="127.0.0.1"
W5BaseOperationMode="${W5BASE_OPERATION_MODE}"
