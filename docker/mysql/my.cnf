#
# docker/mysql/my.cnf - W5Base MySQL server timeout tuning (additive drop-in).
#
# WHAT: Raises three MySQL server timeouts for the `db` service.
# WHY:  W5Base sometimes issues very long-running queries directly over the
#       network; with default timeouts the server drops the connection mid-query,
#       producing "Lost connection to MySQL server during query". mod_perl /
#       Apache::DBI also holds pooled connections idle for long periods, which
#       the default `wait_timeout` would sever. (Documented in README.txt L490-L497.)
# HOW:  docker-compose.yml mounts this file read-only into the db container at
#       /etc/mysql/conf.d/w5base.cnf, where MySQL/MariaDB auto-includes conf.d/*.cnf.
#       No secrets live here - credentials come from env + the entrypoint.
#
[mysqld]
# Max seconds the server waits for more data from a connection mid-read (default 30).
net_read_timeout=3600
# Max seconds the server waits to write a block to a connection (default 60).
net_write_timeout=3600
# Seconds the server keeps a non-interactive (pooled) connection open when idle
# (345600s = 4 days) so long-idle mod_perl/Apache::DBI connections are not dropped.
wait_timeout=345600
