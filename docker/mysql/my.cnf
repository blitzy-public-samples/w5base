#
# docker/mysql/my.cnf - W5Base MySQL server SQL-mode compatibility + timeout tuning
#                       (additive drop-in).
#
# WHAT: (1) Relaxes MySQL's server SQL mode so the legacy W5Base schema loads, and
#       (2) raises three MySQL server timeouts for the `db` service.
# WHY:  (1) SQL MODE - W5Base's kernel builds control/data tables (e.g. the
#           foundational `tableversion` table, defined in mod/base/menu.pm) using
#           legacy MySQL datetime defaults such as `DEFAULT '0000-00-00 00:00:00'`.
#           MySQL 8's DEFAULT strict sql_mode (STRICT_TRANS_TABLES, NO_ZERO_DATE,
#           NO_ZERO_IN_DATE) REJECTS those defaults with "ERROR 1067 Invalid default
#           value", so `sbin/W5Event ... TableVersionCheck` fails at the very first
#           table and builds ZERO tables - the containerized environment then never
#           reaches a running W5Base. The application schema (mod/**, sql/**) is
#           out of scope and must not be edited, so the correct, backward-compatible
#           fix is to relax the SERVER sql_mode here (empty = permissive), exactly as
#           the base environment's own host config (99-w5base.cnf) does. This is a
#           server-wide setting for this dev/validation database only.
#       (2) TIMEOUTS - W5Base sometimes issues very long-running queries directly over
#           the network; with default timeouts the server drops the connection
#           mid-query, producing "Lost connection to MySQL server during query".
#           mod_perl / Apache::DBI also holds pooled connections idle for long
#           periods, which the default `wait_timeout` would sever.
#           (Documented in README.txt L490-L497.)
# HOW:  docker-compose.yml mounts this file read-only into the db container at
#       /etc/mysql/conf.d/w5base.cnf, where MySQL/MariaDB auto-includes conf.d/*.cnf.
#       No secrets live here - credentials come from env + the entrypoint.
#
[mysqld]
# Empty sql_mode = permissive: accept the legacy W5Base schema's `0000-00-00`
# datetime defaults instead of rejecting them under MySQL 8's default strict mode.
# Without this the schema build (TableVersionCheck) fails on the first table and
# creates zero tables. Mirrors the base environment's host 99-w5base.cnf.
sql_mode=""
# Max seconds the server waits for more data from a connection mid-read (default 30).
net_read_timeout=3600
# Max seconds the server waits to write a block to a connection (default 60).
net_write_timeout=3600
# Seconds the server keeps a non-interactive (pooled) connection open when idle
# (345600s = 4 days) so long-idle mod_perl/Apache::DBI connections are not dropped.
wait_timeout=345600
