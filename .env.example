# =============================================================================
# W5Base / Darwin - Containerized Local Development Environment
# Environment variable template  (.env.example)
# =============================================================================
#
# WHAT THIS FILE IS
#   This is a *template*. It is the canonical, committed list of every
#   environment variable consumed by the local development stack:
#     - docker-compose.yml    (loads this file via `env_file:`)
#     - docker/entrypoint.sh  (exports these to configure and boot W5Base)
#     - the rendered /etc/w5base/*.conf files (docker/w5base/*.conf.tmpl)
#
# HOW TO USE IT
#   1. Copy this file to `.env`:          cp .env.example .env
#   2. Edit `.env` and replace every `change-me-*` placeholder (and the
#      documented legacy defaults) with strong, real values for your machine.
#   3. `docker compose up` reads `.env` automatically and starts the stack.
#      The main menu then renders at:
#          ${W5BASE_BASE_URL}/w5base/auth/base/menu/root
#
# SECURITY - READ THIS
#   * This template contains PLACEHOLDERS ONLY. Never put real secrets here.
#   * Keep real secrets in `.env`, which must NEVER be committed. Add `.env`
#     to .gitignore. Only this template (`.env.example`) is committed - and it
#     deliberately holds no real credentials.
#   * The historical W5Base defaults `dummy/admin` (user) and `acache`
#     (password) are publicly documented and MUST be changed - see the
#     W5BASE_ADMIN / W5BASE_ADMIN_PASSWORD entries below
#     (README.txt, "Running W5Base and operating hints").
#   * Oracle and LDAP variables are intentionally omitted: they are out of
#     scope for this base, and running Net::LDAP together with DBD::Oracle in a
#     single process is a documented segmentation-fault hazard.
# =============================================================================


# --- W5Base application ---

# DBI connect string for the `w5base` schema. It is rendered into
# databases.conf as DATAOBJCONNECT[w5base]. The host is the Docker Compose
# service name `db` (the database runs in its own container), NOT `localhost`.
# This string intentionally carries no credentials; the database user and
# password are supplied separately (see W5BASE_DB_PASSWORD / MYSQL_USER below).
W5BASE_DSN=dbi:mysql:database=w5base;host=db;port=3306

# Password for the `w5base` MySQL application user. Rendered into
# databases.conf as DATAOBJPASS[w5base]. This MUST match MYSQL_PASSWORD below,
# because the database container creates the app user with MYSQL_PASSWORD and
# W5Base then authenticates with this value.
W5BASE_DB_PASSWORD=change-me-w5base-db-password

# REMOTE_USER identity that is ALWAYS treated as master admin, even before the
# in-application user administration has been initialized. It is rendered into
# w5base.conf as MASTERADMIN=${W5BASE_ADMIN}. The value follows the REMOTE_USER
# convention `<config>/<user>` (for example: local/admin).
# CHANGE the legacy default `dummy/admin`.
W5BASE_ADMIN=local/admin

# HTTP Basic Auth password for the admin identity in W5BASE_ADMIN. It seeds the
# container's htpasswd file so you can reach the main menu as the admin user.
# CHANGE the legacy default `acache`.
W5BASE_ADMIN_PASSWORD=change-me-admin-password

# Install directory inside the container where the repository is checked out.
# The kernel reads $W5BASEINSTDIR, and the Apache mod_perl preload sets
# $W5V2::INSTDIR to the same path before requiring sbin/ApacheStartup.pl.
W5BASEINSTDIR=/opt/w5base

# W5Base service account name. This account owns the runtime directories
# (/etc/w5base, /var/opt/w5base, /var/opt/w5base/state, /var/log/w5base) and is
# the user that runs sbin/W5Server.
W5BASESRVUSER=w5base

# Base URL used to reach the application from your host. The W5Base main menu
# is served at ${W5BASE_BASE_URL}/w5base/auth/base/menu/root. The port here
# must match the port docker-compose.yml publishes for the app container.
W5BASE_BASE_URL=http://localhost:8080

# W5Base operation mode. It must be IDENTICAL between W5Server and the web
# frontend, otherwise the frontend refuses to talk to the control plane.
# Valid values (etc/w5base/default.conf):
#   test | automodify | online | normal | maintenance | offline | dev |
#   slave | readonly[:comment]
# etc/w5base/default.conf ships "online"; "normal" is a safe local-dev default.
W5BASE_OPERATION_MODE=normal


# --- Database service ---
# These variables seed the official MySQL / MariaDB container on first start.
# The image uses them to create the schema and the application user with modern
# CREATE USER / GRANT (replacing the legacy `INSERT INTO user` recipe from the
# old README). The application container's entrypoint then connects with the
# same database, user, and password to build the schema via TableVersionCheck.

# Root password for the database container. Used only for container
# administration; the application itself never connects as root.
MYSQL_ROOT_PASSWORD=change-me-root-password

# Application schema name created on first container start. Keep this as
# `w5base` so it matches `database=w5base` in W5BASE_DSN.
MYSQL_DATABASE=w5base

# Application database user that the container creates and grants access to
# MYSQL_DATABASE. Keep this equal to the user W5Base connects as (the `w5base`
# account referenced by W5BASE_DSN).
MYSQL_USER=w5base

# Password assigned to MYSQL_USER when the container provisions it. This MUST
# be identical to W5BASE_DB_PASSWORD above: the database container creates the
# user with this value, and W5Base authenticates using W5BASE_DB_PASSWORD.
MYSQL_PASSWORD=change-me-w5base-db-password
